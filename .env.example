# Database
DATABASE_URL="postgresql://cartigo:cartigo@localhost:5432/cartigo?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Redis (rate limiting, caching, queues — wired up in a later slice)
REDIS_URL="redis://localhost:6379"

# Object storage (product images, reseller documents) — later slice
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Payment provider abstraction — later slice
PAYMENT_PROVIDER="stripe"
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Seed data (local/dev only — never set these in production)
SEED_ADMIN_EMAIL="admin@cartigo.local"
SEED_ADMIN_PASSWORD="change-me-now"
